{
  "expo": {
    "name": "ResQHub",
    "slug": "resqhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "resqhub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resqhub.emergency"
    },
    "android": {
      "package": "com.resqhub.emergency",
      "adaptiveIcon": {
        "backgroundColor": "#0A192F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.VIBRATE",
        "android.permission.CALL_PHONE",
        "android.permission.SEND_SMS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.WRITE_CONTACTS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A192F"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ResQHub needs your location to send coordinates to your emergency contacts during an SOS."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "ResQHub allows you to select your trusted emergency contacts from your phonebook."
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/withDirectSms"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06a4f75e-50f4-4d41-be53-7b2981d7e2a9"
      }
    },
    "owner": "solutioninfinite"
  }
}
