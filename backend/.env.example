# ==============================================================================
# ResQHub Emergency Safety Platform - Backend Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & CORS
# In production, set to your specific mobile app origin or custom scheme
ALLOWED_ORIGINS=*
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
API_KEY=resqhub-development-api-key

# Database Configuration
# Local SQLite default for development & testing
DATABASE_URL=sqlite:///./resqhub.db
# PostgreSQL for production (example):
# DATABASE_URL=postgresql+psycopg2://resqhub_user:secure_password@localhost:5432/resqhub_db

# ==============================================================================
# Twilio Emergency SMS Configuration
# ==============================================================================
# CRITICAL: These credentials must NEVER be stored in the mobile app binary.
# The mobile client calls the FastAPI /alerts endpoint, which sends SMS via Twilio.

# 1. Mock Mode (Default for Local Development & Testing):
# When MOCK_SMS_PROVIDER=true, no actual SMS is sent through Twilio.
# The server simulates SMS dispatch, generates a mock message SID (SM_mock_...),
# logs the payload, and returns "queued" delivery status.
MOCK_SMS_PROVIDER=true

# 2. Live Twilio Mode (For Real SMS Delivery to Contacts):
# Set MOCK_SMS_PROVIDER=false and provide your real Twilio credentials below:
# - TWILIO_ACCOUNT_SID: Found on the Twilio Console dashboard (starts with 'AC')
# - TWILIO_AUTH_TOKEN: Found on the Twilio Console dashboard
# - TWILIO_FROM_NUMBER: Your purchased Twilio phone number in E.164 format (e.g., +15005550006)
# - TWILIO_WEBHOOK_URL: Public URL where Twilio can post delivery status receipts
#   (e.g., via ngrok tunnel during development: https://xxxx.ngrok-free.app/api/v1/alerts/webhook/twilio)
#
# Note: For Indian recipient numbers, ResQHub automatically normalizes 10-digit
# numbers (e.g. 9876543210) to E.164 format (+919876543210).
TWILIO_ACCOUNT_SID=AC_dummy_account_sid_placeholder_12345
TWILIO_AUTH_TOKEN=dummy_auth_token_placeholder_67890
TWILIO_FROM_NUMBER=+15005550006
TWILIO_WEBHOOK_URL=http://localhost:8000/api/v1/alerts/webhook/twilio
